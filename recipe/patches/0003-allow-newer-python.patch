From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: conda-forge quadrants-feedstock <conda-forge@users.noreply.github.com>
Date: Wed, 4 Nov 2026 16:30:00 -0800
Subject: [PATCH] Allow Python 3.15 and newer

Upstream caps requires-python below 3.15 because its CI and wheels stop at
3.14. Drop the cap so pip can install the extension on newer interpreters.
---
 pyproject.toml | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/pyproject.toml b/pyproject.toml
index be5a27f..4b143bd 100644
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -17,7 +17,7 @@ license = "Apache-2.0"
 keywords = ["graphics", "simulation"]
 dynamic = ["version"]
 readme = "README.md"
-requires-python = ">=3.12,<3.15"
+requires-python = ">=3.12"
 dependencies = [
     "numpy>=1.26.0; python_version < '3.14'",
     "numpy>=2.3.4; python_version >= '3.14'",
